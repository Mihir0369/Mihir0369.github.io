	partition fact_quarter = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ModelFolder & "\fact_harms_quarter.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"source", type text}, {"substance", type text}, {"region", type text}, {"quarter_start", type date}, {"number", type number}, {"number_status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
