		sourceColumn: source

	column substance
		dataType: string
		isHidden
		lineageTag: b2b6c241-014a-5b5d-99ac-c1e8fbe08d80
		summarizeBy: none
		sourceColumn: substance

	column region
		dataType: string
		isHidden
		lineageTag: 655d7e3e-1c38-5552-beda-792d06cb8622
		summarizeBy: none
		sourceColumn: region

	column quarter_start
		dataType: dateTime
		isHidden
		lineageTag: f9a774ba-7cfd-59f4-a791-f33cbe778ba9
		summarizeBy: none
