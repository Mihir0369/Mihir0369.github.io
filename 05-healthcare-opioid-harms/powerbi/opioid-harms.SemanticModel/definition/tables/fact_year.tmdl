	partition fact_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ModelFolder & "\fact_harms_year.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"source", type text}, {"substance", type text}, {"region", type text}, {"year", Int64.Type}, {"number", type number}, {"number_status", type text}, {"crude_rate", type number}, {"rate_status", type text}, {"partial_period", Int64.Type}}, "en-US"),
				    AddDate = Table.AddColumn(Typed, "YearStart", each #date([year], 1, 1), type date)
				in
				    AddDate

	annotation PBI_ResultType = Table
