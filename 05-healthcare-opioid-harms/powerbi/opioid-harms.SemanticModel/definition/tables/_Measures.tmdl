	measure 'Opioid EMS Peak' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) RETURN MAXX ( yrs, CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "EMS responses", Dim_Substance[Substance] = "Opioids" ) )
		formatString: #,0
