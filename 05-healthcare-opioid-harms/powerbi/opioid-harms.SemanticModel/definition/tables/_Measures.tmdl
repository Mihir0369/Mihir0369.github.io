		formatString: 0.00%
		lineageTag: e935dbd6-3383-5423-a349-df2ad7a7b481

	measure 'Age 30 to 49 Share' = DIVIDE ( CALCULATE ( [Age Count (Focus Year)], Dim_Age[Age group] IN { "30 to 39 years", "40 to 49 years" } ), [Age Count (Focus Year)] )
		formatString: 0.00%
		lineageTag: 4f4fa8af-ccd2-5255-9da6-24bbd7255b78

	measure 'Heat Count' = VAR y = SELECTEDVALUE ( Dim_HeatYear[Heat Year Number] ) VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Age Sex Count], REMOVEFILTERS ( Date ), fact_age[year] = y, Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: #,0
		lineageTag: 80f61b4a-8786-5611-a698-4d6091a0213a

	measure 'Tile Max' = CALCULATE ( MAXX ( FILTER ( ALL ( Dim_Region ), Dim_Region[Tile Row] > 0 ), [Rate (Focus Year)] ), ALL ( Dim_Region ) )
		formatString: 0.0
		lineageTag: c044b2af-bdfb-5143-993a-0b0ea56e9af7

	measure 'Tile Label' = VAR code = SELECTEDVALUE ( Dim_Region[Tile Code], "" ) VAR r = [Rate (Focus Year)] RETURN IF ( code = "", BLANK (), code & IF ( ISBLANK ( r ), "  n/a", "  " & FORMAT ( r, "0.0" ) ) )
		lineageTag: 7bf0e9ea-84da-51b2-939d-04cc39e32077

	measure 'Tile Fill' = VAR code = SELECTEDVALUE ( Dim_Region[Tile Code], "" ) VAR r = [Rate (Focus Year)] VAR k = DIVIDE ( r, [Tile Max] ) RETURN IF ( code = "", BLANK (), IF ( ISBLANK ( r ), "#E3E3E3", SWITCH ( TRUE (), k < 0.2, "#E4ECF3", k < 0.4, "#A9C3D9", k < 0.6, "#5F8FB5", k < 0.8, "#2D5F8A", "#1B3A5C" ) ) )
		lineageTag: 4595b91d-77a0-5d02-9d3b-975dd67322db

	measure 'Tile Font' = VAR code = SELECTEDVALUE ( Dim_Region[Tile Code], "" ) VAR r = [Rate (Focus Year)] VAR k = DIVIDE ( r, [Tile Max] ) RETURN IF ( code = "", BLANK (), IF ( ISBLANK ( r ), "#8A8A8A", IF ( k < 0.4, "#1F2D3D", "#FFFFFF" ) ) )
		lineageTag: 8e8032e1-81bb-5601-a2de-847494d23ca6

	measure 'Tile Extremes' = VAR t = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( Dim_Region ), Dim_Region[Tile Row] > 0 ), "r", [Rate (Focus Year)] ), NOT ISBLANK ( [r] ) ) VAR hi = TOPN ( 1, t, [r], DESC ) VAR lo = TOPN ( 1, t, [r], ASC ) RETURN IF ( COUNTROWS ( t ) = 0, "No rates for this selection.", "Highest: " & MAXX ( hi, Dim_Region[Region] ) & " (" & FORMAT ( MAXX ( hi, [r] ), "0.0" ) & "). Lowest: " & MAXX ( lo, Dim_Region[Region] ) & " (" & FORMAT ( MAXX ( lo, [r] ), "0.0" ) & ")." )
		lineageTag: f04a4a13-5751-52f9-9752-c77e8d6dff93

