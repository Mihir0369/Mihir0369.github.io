	measure 'Regions With Rate Sub' = "of the provinces and territories"
		lineageTag: 63b65810-f25d-501e-8b9f-4bf7c3ed3381

	measure 'Canada Rate Text' = VAR c = CALCULATE ( [Rate (Focus Year)], Dim_Region[Region] = "Canada" ) RETURN IF ( ISBLANK ( c ), "Canada: no rate is published for this source.", "Canada: " & FORMAT ( c, "0.0" ) & " per 100,000, counting only the places that report." )
		lineageTag: 4bbed78e-c659-5963-b88c-685a10289d14

	measure 'Heat Max' = CALCULATE ( MAXX ( CROSSJOIN ( ALL ( Dim_Age[Age group] ), ALL ( Dim_HeatYear[Heat Year] ) ), [Heat Count] ), ALL ( Dim_Age ), ALL ( Dim_HeatYear ) )
		formatString: #,0
		lineageTag: 712e5699-e668-5153-b267-cb785a39a9bf

	measure 'Heat Fill' = VAR v = [Heat Count] VAR k = DIVIDE ( v, [Heat Max] ) RETURN IF ( ISBLANK ( v ), BLANK (), SWITCH ( TRUE (), k < 0.1, "#FFF4DC", k < 0.25, "#FBD9A0", k < 0.45, "#F4B860", k < 0.7, "#E08A1E", "#B85C00" ) )
		lineageTag: 0928804f-01d1-5079-a8c6-c9179c29fcf1

	measure 'Heat Font' = VAR v = [Heat Count] VAR k = DIVIDE ( v, [Heat Max] ) RETURN IF ( ISBLANK ( v ), BLANK (), IF ( k < 0.45, "#1F2D3D", "#FFFFFF" ) )
		lineageTag: a5a98e04-18f2-5a5c-90fe-b9d9d73b4607

	measure 'Coverage Status' = CALCULATE ( IF ( COUNTROWS ( fact_year ) = 0, "Not in file", SELECTEDVALUE ( fact_year[number_status] ) ), REMOVEFILTERS ( Date ), fact_year[year] = 2024, Dim_Substance[Substance] = "Opioids" )
		lineageTag: 4f6ae1a3-04e6-5850-ad58-077e59d34fa2

	measure 'Coverage Fill' = SWITCH ( [Coverage Status], "Reported", "#CFE6EA", "Suppressed", "#FBE3B3", "Not available", "#E3E3E3", "#FFFFFF" )
		lineageTag: e700f052-3c2f-5ffe-abbd-390cdc596fe7

	measure 'Coverage Font' = SWITCH ( [Coverage Status], "Not in file", "#B5B5B5", "Not available", "#6B6B6B", "#1F2D3D" )
		lineageTag: 4e5c827f-2294-5677-abd8-4bbc3870ccc4

	measure 'Age Count Sel' = VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Age Sex Count], Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: #,0
