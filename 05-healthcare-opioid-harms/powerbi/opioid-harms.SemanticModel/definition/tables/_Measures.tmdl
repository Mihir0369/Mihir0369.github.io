		formatString: 0.0
		lineageTag: 8ac474a3-1a98-5de9-8dd0-6cc08088f54d

	measure 'Highest Region' = VAR t = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( Dim_Region ), Dim_Region[Tile Row] > 0 ), "r", [Rate (Focus Year)] ), NOT ISBLANK ( [r] ) ) RETURN IF ( COUNTROWS ( t ) = 0, "No rates for this selection", MAXX ( TOPN ( 1, t, [r], DESC ), Dim_Region[Region] ) )
		lineageTag: 2d01d726-ae8b-548b-9299-8eb7b32276f4

	measure 'Lowest Rate' = VAR t = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( Dim_Region ), Dim_Region[Tile Row] > 0 ), "r", [Rate (Focus Year)] ), NOT ISBLANK ( [r] ) ) RETURN IF ( COUNTROWS ( t ) = 0, BLANK (), MINX ( t, [r] ) )
		formatString: 0.0
