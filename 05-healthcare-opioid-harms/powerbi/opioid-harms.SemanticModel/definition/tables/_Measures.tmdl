	measure 'Share of Group' = DIVIDE ( [Age Count (Focus Year)], CALCULATE ( [Age Count (Focus Year)], REMOVEFILTERS ( Dim_Age ), REMOVEFILTERS ( Dim_Sex ) ) )
		formatString: 0.00%
