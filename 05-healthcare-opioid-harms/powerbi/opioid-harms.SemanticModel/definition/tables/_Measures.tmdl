	measure 'Deaths Latest Quarter YoY %' = VAR q = [Latest Quarter] VAR cur = CALCULATE ( [Quarter Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Deaths", Dim_Substance[Substance] = "Opioids", fact_quarter[quarter_start] = q ) VAR py = CALCULATE ( [Quarter Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Deaths", Dim_Substance[Substance] = "Opioids", fact_quarter[quarter_start] = EDATE ( q, -12 ) ) RETURN DIVIDE ( cur - py, py )
