		lineageTag: f5cfa074-0b99-529c-9097-c982aa4837ca

	measure 'Regions With Rate' = VAR t = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( Dim_Region ), Dim_Region[Tile Row] > 0 ), "r", [Rate (Focus Year)] ), NOT ISBLANK ( [r] ) ) RETURN COUNTROWS ( t )
		formatString: 0
