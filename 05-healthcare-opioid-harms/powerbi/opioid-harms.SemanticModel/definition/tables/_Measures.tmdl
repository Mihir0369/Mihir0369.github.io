table _Measures
	lineageTag: 76950b0a-1ffc-5e3f-87a0-9eece5aeea47

	measure Count = VAR scoped = ISFILTERED ( Dim_Region ) RETURN IF ( scoped, SUM ( fact_year[number] ), CALCULATE ( SUM ( fact_year[number] ), Dim_Region[Region] = "Canada" ) )
		formatString: #,0
		lineageTag: cc55794b-2236-59cd-9a99-a02fd63ea3e2

	measure 'Rate per 100k' = VAR scoped = ISFILTERED ( Dim_Region ) RETURN IF ( scoped, MAX ( fact_year[crude_rate] ), CALCULATE ( MAX ( fact_year[crude_rate] ), Dim_Region[Region] = "Canada" ) )
		formatString: 0.0
		lineageTag: b9f1fa6d-de60-5c10-b26d-870f59bec457

	measure 'Quarter Count' = VAR scoped = ISFILTERED ( Dim_Region ) RETURN IF ( scoped, SUM ( fact_quarter[number] ), CALCULATE ( SUM ( fact_quarter[number] ), Dim_Region[Region] = "Canada" ) )
		formatString: #,0
		lineageTag: c5ec271d-b9ff-59a0-87a7-c9b203ad6711

	measure 'Age Sex Count' = VAR scoped = ISFILTERED ( Dim_Region ) RETURN IF ( scoped, SUM ( fact_age[number] ), CALCULATE ( SUM ( fact_age[number] ), Dim_Region[Region] = "Canada" ) )
		formatString: #,0
		lineageTag: 413843fe-e178-5d48-baca-85ee22e86944

	measure 'Sel Source' = SELECTEDVALUE ( Dim_Source[Source], "Deaths" )
		lineageTag: 8e7e7771-a2ea-5f92-be4d-f456001867e8

	measure 'Sel Substance' = SELECTEDVALUE ( Dim_Substance[Substance], "Opioids" )
		lineageTag: bbd18fb5-cdef-5a6f-9166-a00f20f8f923

	measure 'Latest Full Year' = CALCULATE ( MAX ( fact_year[year] ), REMOVEFILTERS (), fact_year[partial_period] = 0 )
		formatString: 0
		lineageTag: a2295a3c-275a-50c5-badf-7ea92736dcd0

	measure 'Default Year' = 2024
		formatString: 0
		lineageTag: 310ecb73-3b3b-5a04-b316-b00b65ecf62c

	measure 'Focus Year' = SELECTEDVALUE ( 'Date'[Year], [Default Year] )
		formatString: 0
		lineageTag: 0f7544e2-6fe5-5208-bf9c-665c1a91eb51

	measure 'Focus Year Label' = VAR y = [Focus Year] RETURN IF ( y = 2026, "2026 (Jan to Mar)", FORMAT ( y, "0" ) )
		lineageTag: 52101d81-0f5c-5c41-9e20-06a79b68d7c7

	measure 'Showing Short' = "Showing: " & [Sel Source] & ", " & LOWER ( [Sel Substance] )
		lineageTag: 1268da0e-d619-5094-848d-22a26ca9fdc0

	measure 'Showing Text' = "Showing: " & [Sel Source] & ", " & LOWER ( [Sel Substance] ) & ", " & [Focus Year Label]
		lineageTag: 249d72e6-67f6-5598-b721-079bad04d85b

	measure 'Count Sel' = VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Count], Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: #,0
		lineageTag: 61ccb597-d47c-5ae3-b605-22a27efacece

	measure 'Rate Sel' = VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Rate per 100k], Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: 0.0
		lineageTag: 338e34fe-7b63-568b-bac3-ed24dfbad45a

	measure 'Count (Focus Year)' = VAR y = [Focus Year] VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Count], REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: #,0
		lineageTag: f05f72b0-04af-5fcb-a776-c684043ab23e

	measure 'Rate (Focus Year)' = VAR y = [Focus Year] VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Rate per 100k], REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: 0.0
		lineageTag: 5f71ef98-469d-5e36-882e-cdae86bf0764

	measure 'Value Status' = VAR y = [Focus Year] VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( IF ( COUNTROWS ( fact_year ) = 0, BLANK (), SELECTEDVALUE ( fact_year[number_status] ) ), REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		lineageTag: cd8c274f-5b26-57bd-be5f-8391e97a13c1

	measure 'Rate Available Text' = VAR s = [Sel Source] RETURN IF ( s = "EMS responses", "PHAC publishes no rate for EMS responses, so this page shows counts only.", "Crude rate per 100,000 population, not age-adjusted." )
		lineageTag: 6bc21ea4-ddab-5f96-9206-bb993fc27b60

	measure 'Latest Quarter' = CALCULATE ( MAX ( fact_quarter[quarter_start] ), REMOVEFILTERS ( Date ) )
		formatString: mmm yyyy
		lineageTag: 4d679de9-ba6a-5afb-b8b6-9e67c1c5cce1

	measure 'Latest Quarter Text' = VAR q = [Latest Quarter] RETURN YEAR ( q ) & " Q" & ROUNDUP ( MONTH ( q ) / 3, 0 )
		lineageTag: 1645331a-3e7e-59d3-b07f-b0a46e1ae067

	measure 'Quarter Count Sel' = VAR s = [Sel Source] VAR sub = [Sel Substance] RETURN CALCULATE ( [Quarter Count], Dim_Source[Source] = s, Dim_Substance[Substance] = sub )
		formatString: #,0
		lineageTag: baca7db6-0959-50af-bb20-0e029aacefd6

	measure 'Latest Quarter Count' = VAR q = [Latest Quarter] RETURN CALCULATE ( [Quarter Count Sel], REMOVEFILTERS ( Date ), fact_quarter[quarter_start] = q )
		formatString: #,0
		lineageTag: 20db6b76-e873-5faa-96a5-cdec12b8bace

	measure 'Prior Year Quarter Count' = VAR q = [Latest Quarter] RETURN CALCULATE ( [Quarter Count Sel], REMOVEFILTERS ( Date ), fact_quarter[quarter_start] = EDATE ( q, -12 ) )
		formatString: #,0
		lineageTag: 069ee77e-10f4-5a96-aeca-1f5aa54cc94e

	measure 'Quarter YoY %' = DIVIDE ( [Latest Quarter Count] - [Prior Year Quarter Count], [Prior Year Quarter Count] )
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 9533cd61-d605-5ee4-9d6c-83566098c580

	measure 'Peak Quarter Count' = CALCULATE ( MAXX ( VALUES ( fact_quarter[quarter_start] ), [Quarter Count Sel] ), REMOVEFILTERS ( Date ) )
		formatString: #,0
		lineageTag: 8f6b18e0-9438-56c7-a4c6-d322967aa70e

	measure 'Peak Quarter' = VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( fact_quarter[quarter_start] ), REMOVEFILTERS ( Date ) ), "v", [Quarter Count Sel] ) RETURN MINX ( TOPN ( 1, t, [v], DESC ), fact_quarter[quarter_start] )
		formatString: mmm yyyy
		lineageTag: c88c2cd7-23c9-57d8-b30a-5fe3635a21e2

	measure 'Peak Quarter Text' = "Highest quarter was " & FORMAT ( [Peak Quarter], "mmm yyyy" )
		lineageTag: 251392ef-a4fb-5585-a97d-36cfbf0bbbc7

	measure 'Trend Headline' = [Showing Short] & ". " & [Latest Quarter Text] & " is " & FORMAT ( [Quarter YoY %], "+0.00%;-0.00%" ) & " vs a year earlier."
		lineageTag: d959c444-15d9-5814-a93a-a907723e6d74

	measure 'Latest Full Year Count' = VAR y = [Latest Full Year] RETURN CALCULATE ( [Count Sel], REMOVEFILTERS ( Date ), fact_year[year] = y )
		formatString: #,0
		lineageTag: f067e2cf-1e7c-5575-953c-431400804396

	measure 'Latest Full Year Text' = "Full year " & [Latest Full Year]
		lineageTag: e176b638-ea79-5cec-9838-5b8ad6723ba6

	measure 'Opioid Deaths LFY' = VAR y = [Latest Full Year] RETURN CALCULATE ( [Count], REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = "Deaths", Dim_Substance[Substance] = "Opioids" )
		formatString: #,0
		lineageTag: 91a1d53a-7e64-5495-9fba-bdf5fe7840a7

	measure 'Opioid Deaths Peak' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) RETURN MAXX ( yrs, CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Deaths", Dim_Substance[Substance] = "Opioids" ) )
		formatString: #,0
		lineageTag: 90865f1f-b317-5b71-b813-516d5be5383f

	measure 'Opioid Deaths Peak Year' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) VAR t = ADDCOLUMNS ( yrs, "v", CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Deaths", Dim_Substance[Substance] = "Opioids" ) ) RETURN MAXX ( TOPN ( 1, t, [v], DESC ), fact_year[year] )
		formatString: 0
		lineageTag: 49861689-3d2a-5165-bb84-ed1f9e3e0654

	measure 'Opioid Deaths vs Peak %' = DIVIDE ( [Opioid Deaths LFY] - [Opioid Deaths Peak], [Opioid Deaths Peak] )
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: bfb1d6e6-897a-562c-b4f0-6893ae8c901c

	measure 'Opioid Hosp LFY' = VAR y = [Latest Full Year] RETURN CALCULATE ( [Count], REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = "Hospital stays", Dim_Substance[Substance] = "Opioids" )
		formatString: #,0
		lineageTag: 413f4e4f-1678-5b54-9c8d-db49365ac906

	measure 'Opioid Hosp Peak' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) RETURN MAXX ( yrs, CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Hospital stays", Dim_Substance[Substance] = "Opioids" ) )
		formatString: #,0
		lineageTag: 535f8f7e-481a-56b4-9918-76648a805816

	measure 'Opioid Hosp Peak Year' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) VAR t = ADDCOLUMNS ( yrs, "v", CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Hospital stays", Dim_Substance[Substance] = "Opioids" ) ) RETURN MAXX ( TOPN ( 1, t, [v], DESC ), fact_year[year] )
		formatString: 0
		lineageTag: b97b633f-f64f-57b9-9c0a-1cf9866fca06

	measure 'Opioid Hosp vs Peak %' = DIVIDE ( [Opioid Hosp LFY] - [Opioid Hosp Peak], [Opioid Hosp Peak] )
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 261cff09-a2a1-522b-a8d1-774d4f3a445a

	measure 'Opioid ED LFY' = VAR y = [Latest Full Year] RETURN CALCULATE ( [Count], REMOVEFILTERS ( Date ), fact_year[year] = y, Dim_Source[Source] = "Emergency department visits", Dim_Substance[Substance] = "Opioids" )
		formatString: #,0
