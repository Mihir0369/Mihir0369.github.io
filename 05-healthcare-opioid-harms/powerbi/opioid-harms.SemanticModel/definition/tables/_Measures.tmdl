	measure 'Opioid ED Peak' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) RETURN MAXX ( yrs, CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Emergency department visits", Dim_Substance[Substance] = "Opioids" ) )
		formatString: #,0
		lineageTag: b7a2a218-b41c-50cb-8615-e367ee4c2ed0

	measure 'Opioid ED Peak Year' = VAR yrs = CALCULATETABLE ( VALUES ( fact_year[year] ), REMOVEFILTERS ( Date ), fact_year[partial_period] = 0 ) VAR t = ADDCOLUMNS ( yrs, "v", CALCULATE ( [Count], REMOVEFILTERS ( Date ), Dim_Source[Source] = "Emergency department visits", Dim_Substance[Substance] = "Opioids" ) ) RETURN MAXX ( TOPN ( 1, t, [v], DESC ), fact_year[year] )
		formatString: 0
		lineageTag: 881fed01-a70d-5421-9fe5-229944f62523

	measure 'Opioid ED vs Peak %' = DIVIDE ( [Opioid ED LFY] - [Opioid ED Peak], [Opioid ED Peak] )
