model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["fact_year","fact_quarter","fact_age","ModelFolder"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table fact_year
ref table fact_quarter
ref table fact_age
ref table Date
ref table _Measures
ref table Dim_Source
ref table Dim_Substance
ref table Dim_Region
ref table Dim_Age
ref table Dim_Sex
ref table Dim_HeatYear

ref cultureInfo en-US
