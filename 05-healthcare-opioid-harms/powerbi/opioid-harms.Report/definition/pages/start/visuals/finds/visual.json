          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the data shows",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Opioid deaths are 29% below the 2023 peak (8,083 to 5,704), but EMS responses are only 8% below theirs. The measures do not fall together.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Rates vary widely: in 2024 British Columbia had 35.7 deaths per 100,000, Ontario 14.0 and Quebec 3.4.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Around three in four deaths are men, and about half are aged 30 to 49.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
