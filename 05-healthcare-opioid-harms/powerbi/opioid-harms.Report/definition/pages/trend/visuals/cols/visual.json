                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Year Label"
                }
              },
              "queryRef": "Date.Year Label",
              "nativeQueryRef": "Year Label",
              "displayName": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Count Sel"
                }
              },
              "queryRef": "_Measures.Count Sel",
              "nativeQueryRef": "Count Sel",
              "displayName": "Count"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1B3A5C'"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#8A9BAE'"
                    }
                  }
                }
              }
            }
