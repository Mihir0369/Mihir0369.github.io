  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What I found in the file and what I did",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  34,890 rows and 39 columns, with English and French copies of every label. It is a chart export, not a table, so I rebuilt it as three tables (yearly, quarterly, age and sex).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  62.08% of values are numbers (5.11% are real zeros), 24.82% are blank (not available) and 13.09% are suppressed. I keep each kind separate and never show missing as zero.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  A Canada total adds up only the places that report: hospital stays leave out Quebec and emergency department visits cover 7 of 13 provinces and territories.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Quarters add up to as much as 1.57% less than the published year, so I never build a year from quarters.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  2026 covers January to March only. Some 2025 values look provisional (Ontario deaths -37.49%, Quebec +93.14%), so I compare provinces on 2024.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Checks: no duplicate keys, Canada totals reconciled to the places that report, and every headline number checked against a separate Python calculation.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
