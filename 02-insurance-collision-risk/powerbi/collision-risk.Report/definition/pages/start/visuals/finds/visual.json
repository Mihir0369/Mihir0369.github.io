                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Collisions fell 24.38% in 2020, but fatal collisions only 1.29%, so the fatal share rose from 1.53% to 2.00%.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  At night (10 pm to 6 am) 3.41% of collisions are fatal against 1.52% by day. The riskiest hour is 4 am, at 4.89%.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Head-on collisions are 10.96% fatal and cause 17.80% of fatal collisions from 2.82% of all. Occupants with no safety device used die 16.09 times as often (6.98% against 0.43%).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
