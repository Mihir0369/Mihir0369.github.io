            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How I found the collision ID",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  The dictionary lists no collision ID, so my first version derived one from 'vehicle 1, person 1'. It found 185,359 collisions, 413 fewer than the real 185,772, so it had merged collisions that are separate.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  The file does hold a key, C_CASE, that the dictionary does not mention. It gives 185,772 collisions; severity, hour, weather and road surface never change inside a case, and the vehicle count matches 99.56%.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  I used C_CASE. Every fatal collision has a death and no injury collision does (3,508 deaths in 3,225 fatal collisions).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
