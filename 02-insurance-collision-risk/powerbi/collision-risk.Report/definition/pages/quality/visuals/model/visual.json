  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the model is built",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  A star schema: fact_collision and fact_person hold keys and counts only; 15 dimensions hold every label, group and sort order.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Every dimension has an 'unknown' member (key 0), so records with a missing value stay in the totals and show as 'Unknown or not reported', never as (Blank).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Dimensions have hierarchies (for example collision group to collision type) and are loaded through Power Query, which sets types and renames columns.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  One chart shows the unknown share of any field through a disconnected table and a SWITCH measure. A what-if parameter drives the Conditions scenario, and a Time Comparison calculation group (prior year, change, % change) is in the model.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  471,046 source rows (one per person in each vehicle) include 7,416 dummy or unmatched records, such as a dummy person for a parked car. The model keeps 463,630 real people. Two collisions have no recorded month, so they appear only when no year is chosen.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
