relationship person_to_user
	fromColumn: fact_person.user_key
	toColumn: Dim_RoadUser.'User Key'

relationship person_to_safety
	fromColumn: fact_person.safety_key
	toColumn: Dim_Safety.'Safety Key'

relationship person_to_sex
	fromColumn: fact_person.sex_key
	toColumn: Dim_Sex.'Sex Key'

relationship person_to_vehicle
