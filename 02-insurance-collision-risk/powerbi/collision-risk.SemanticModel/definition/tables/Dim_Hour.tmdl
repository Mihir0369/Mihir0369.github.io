	partition Dim_Hour = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ModelFolder & "\dim_hour.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"hour_key", Int64.Type}, {"hour_label", type text}, {"day_part", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"hour_key", "Hour Key"}, {"hour_label", "Hour Label"}, {"day_part", "Day Part"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
