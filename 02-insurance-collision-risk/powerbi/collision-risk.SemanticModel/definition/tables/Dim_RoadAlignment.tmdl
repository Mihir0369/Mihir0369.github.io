	partition Dim_RoadAlignment = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ModelFolder & "\dim_alignment.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"alignment_key", Int64.Type}, {"road_alignment", type text}, {"alignment_group", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"alignment_key", "Alignment Key"}, {"road_alignment", "Road Alignment"}, {"alignment_group", "Alignment Group"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
