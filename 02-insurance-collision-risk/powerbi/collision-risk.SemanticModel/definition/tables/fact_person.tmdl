				    Source = Csv.Document(File.Contents(ModelFolder & "\fact_person.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"collision_id", type text}, {"age", Int64.Type}, {"age_key", Int64.Type}, {"user_key", Int64.Type}, {"safety_key", Int64.Type}, {"sex_key", Int64.Type}, {"vehicle_key", Int64.Type}, {"person_severity_key", Int64.Type}}, "en-US")
