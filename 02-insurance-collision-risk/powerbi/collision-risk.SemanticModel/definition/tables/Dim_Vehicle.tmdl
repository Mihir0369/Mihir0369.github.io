	partition Dim_Vehicle = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ModelFolder & "\dim_vehicle.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"vehicle_key", Int64.Type}, {"vehicle_type", type text}, {"vehicle_group", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"vehicle_key", "Vehicle Key"}, {"vehicle_type", "Vehicle Type"}, {"vehicle_group", "Vehicle Group"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
