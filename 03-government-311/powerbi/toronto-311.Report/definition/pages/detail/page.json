{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "detail",
  "displayName": "Division detail",
  "displayOption": "FitToWidth",
  "height": 1130,
  "width": 1280,
  "objects": {
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F6F4EF'"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas_detail.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas_detail.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ]
  },
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode",
  "filterConfig": {
    "filters": [
      {
        "name": "f_division",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Division"
              }
            },
            "Property": "Division"
          }
        },
        "type": "Categorical"
      }
    ]
  },
  "pageBinding": {
    "name": "bind_detail",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "Param_Division",
        "boundFilter": "f_division",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Division"
              }
            },
            "Property": "Division"
          }
        }
      }
    ]
  }
}