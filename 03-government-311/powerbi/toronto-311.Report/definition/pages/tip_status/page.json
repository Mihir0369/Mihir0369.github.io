{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "tip_status",
  "displayName": "Status tooltip",
  "displayOption": "ActualSize",
  "height": 240,
  "width": 320,
  "objects": {
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F6F4EF'"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#FFFFFF'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ]
  },
  "type": "Tooltip",
  "visibility": "HiddenInViewMode",
  "filterConfig": {
    "filters": [
      {
        "name": "f_division_tip",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Division"
              }
            },
            "Property": "Division"
          }
        },
        "type": "Categorical"
      }
    ]
  },
  "pageBinding": {
    "name": "bind_tip",
    "type": "Tooltip",
    "parameters": [
      {
        "name": "Param_Division_Tip",
        "boundFilter": "f_division_tip",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Division"
              }
            },
            "Property": "Division"
          }
        }
      }
    ]
  }
}