    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to use this report",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Use the page buttons at the top right to move between pages.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Each page opens with its key findings; they change with the filters.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Overview: how demand moved and how much is still open. The Year filter carries across pages.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Outcomes: which divisions leave requests open. Hover over a bar for its outcome mix.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Right-click a division bar, choose Drill through, then Division detail, to see its request types.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Request types: what residents ask for. Use the Taxonomy era filter to compare types fairly.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
