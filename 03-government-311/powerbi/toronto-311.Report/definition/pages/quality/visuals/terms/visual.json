                  {
                    "value": "Terms in plain language",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  311: Toronto's city line for non-emergency service requests.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Open: status Open or In Progress when the data was taken.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Division: the city department that handles the request.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Taxonomy era: whether a request type name existed before January 2025, only after it, or in both periods.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Customer-initiated: requests residents and businesses made, not work the city started itself.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
