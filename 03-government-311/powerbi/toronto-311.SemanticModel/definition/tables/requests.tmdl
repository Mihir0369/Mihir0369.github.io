		annotation UnderlyingDateTimeDataType = Date

	partition requests = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvPath), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"year", Int64.Type}, {"division_group", type text}, {"service_request_type", type text}, {"ward_name", type text}, {"status_group", type text}, {"location_type", type text}, {"requests", Int64.Type}}),
				    AddDate = Table.AddColumn(Typed, "MonthStart", each Date.FromText([month] & "-01"), type date),
				    FixWard = Table.ReplaceValue(AddDate, null, "Unknown ward", Replacer.ReplaceValue, {"ward_name"}),
				    FixDiv = Table.ReplaceValue(FixWard, null, "Unknown division", Replacer.ReplaceValue, {"division_group"}),
				    Slim = Table.RemoveColumns(FixDiv, {"month", "year"})
				in
				    Slim

	annotation PBI_ResultType = Table

