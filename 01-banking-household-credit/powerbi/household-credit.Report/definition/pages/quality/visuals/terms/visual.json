    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Terms in plain language",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Policy rate: the Bank of Canada overnight rate. Prime rate: the rate banks charge their best customers; it follows the policy rate.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Credit growth (year over year): the balance now divided by the balance a year earlier, minus 1.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Debt service ratio: the share of household income used for debt payments.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Lag: the months between a rate change and the credit growth it is compared with.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Correlation: -1 to +1. Negative means credit growth is lower after rates rise. It is not proof of cause.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#4A5B6C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
