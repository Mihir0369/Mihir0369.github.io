                  "Property": "Category"
                }
              },
              "queryRef": "Dim_Category.Category",
              "nativeQueryRef": "Category"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Credit YoY % (Latest)"
                }
              },
              "queryRef": "_Measures.Credit YoY % (Latest)",
              "nativeQueryRef": "Credit YoY % (Latest)",
              "displayName": "Growth vs a year earlier"
