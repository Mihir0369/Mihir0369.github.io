{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/3.0.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "HouseholdCreditPortfolio.json",
      "type": "RegisteredResources",
      "reportVersionAtImport": {
        "visual": "1.8.0",
        "report": "2.0.0",
        "page": "1.3.0"
      }
    }
  },
  "settings": {
    "useStylableVisualContainerHeader": true,
    "defaultDrillFilterOtherVisuals": true,
    "allowChangeFilterTypes": true,
    "useEnhancedTooltips": true
  },
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "HouseholdCreditPortfolio.json",
          "path": "HouseholdCreditPortfolio.json",
          "type": "CustomTheme"
        },
        {
          "name": "canvas_credit.png",
          "path": "canvas_credit.png",
          "type": "Image"
        },
        {
          "name": "canvas_lag.png",
          "path": "canvas_lag.png",
          "type": "Image"
        },
        {
          "name": "canvas_quality.png",
          "path": "canvas_quality.png",
          "type": "Image"
        },
        {
          "name": "canvas_rates.png",
          "path": "canvas_rates.png",
          "type": "Image"
        },
        {
          "name": "canvas_start.png",
          "path": "canvas_start.png",
          "type": "Image"
        }
      ]
    }
  ]
}