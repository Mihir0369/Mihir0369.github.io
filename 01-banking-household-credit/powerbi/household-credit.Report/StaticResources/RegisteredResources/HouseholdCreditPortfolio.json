{
  "name": "Household Credit Portfolio",
  "dataColors": [
    "#1B3A5C",
    "#2A7F8E",
    "#C77700",
    "#8A9BAE",
    "#6B4C7A",
    "#B23A48",
    "#4F6D7A",
    "#C9D3DC"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2D3D",
  "tableAccent": "#1B3A5C",
  "foregroundNeutralSecondary": "#4A5B6C",
  "backgroundLight": "#E4ECF3",
  "good": "#2A7F8E",
  "neutral": "#C77700",
  "bad": "#B23A48",
  "maximum": "#1B3A5C",
  "center": "#8FA9C2",
  "minimum": "#E4ECF3",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "color": "#1B3A5C"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "color": "#1F2D3D"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#1F2D3D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A5B6C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 12,
            "left": 16,
            "right": 16
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#4A5B6C"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#4A5B6C"
              }
            },
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D9E2E8"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#4A5B6C"
              }
            },
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A5B6C"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F4EF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F6F4EF"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B3A5C"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D9E2E8"
              }
            },
            "rowPadding": 5,
            "outlineColor": {
              "solid": {
                "color": "#D9E2E8"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B3A5C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E4ECF3"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E4ECF3"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2D3D"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#4A5B6C"
              }
            }
          }
        ]
      }
    }
  }
}